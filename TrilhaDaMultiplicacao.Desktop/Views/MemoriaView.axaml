<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TrilhaDaMultiplicacao.Desktop.ViewModels"
             xmlns:models="using:TrilhaDaMultiplicacao.Desktop.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="760"
             x:Class="TrilhaDaMultiplicacao.Desktop.Views.MemoriaView"
             x:Name="Root"
             x:DataType="vm:MemoriaViewModel">

    <Panel ClipToBounds="True">

        <Border Background="{DynamicResource AppSceneGradientBrush}" />

        <Canvas IsHitTestVisible="False">
            <Border Canvas.Left="-50" Canvas.Top="-50" Width="210" Height="210" CornerRadius="105"
                    Background="{DynamicResource AppBlueGradientBrush}" Opacity="0.16" />
            <Border Canvas.Left="1010" Canvas.Top="-60" Width="230" Height="230" CornerRadius="115"
                    Background="{DynamicResource AppYellowBrush}" Opacity="0.14" />
            <Border Canvas.Left="1030" Canvas.Top="580" Width="190" Height="190" CornerRadius="95"
                    Background="{DynamicResource AppVioletGradientBrush}" Opacity="0.16" />
            <TextBlock Text="🧠" FontSize="44" Canvas.Left="140" Canvas.Top="560" Opacity="0.4">
                <TextBlock.RenderTransform>
                    <RotateTransform Angle="-8" />
                </TextBlock.RenderTransform>
            </TextBlock>
            <TextBlock Text="✨" FontSize="24" Canvas.Left="940" Canvas.Top="220" Opacity="0.55" />
        </Canvas>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40,24" Spacing="0">

                <!-- ===================== Jogo ===================== -->
                <StackPanel IsVisible="{Binding !JogoConcluido}" Spacing="0" HorizontalAlignment="Center">
                    <Border Width="86" Height="86" CornerRadius="43" HorizontalAlignment="Center" Margin="0,0,0,10"
                            Background="{DynamicResource AppBlueGradientBrush}" BoxShadow="0 10 24 0 #401E4FD1">
                        <TextBlock Text="🧠" FontSize="38" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Text="{Binding TituloFase}" Classes="h1" HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock Text="Encontre os pares: a conta e o resultado dela!" Classes="muted"
                               HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,16" />

                    <Border IsVisible="{Binding MostrandoPreview}" Classes="total-pill"
                            HorizontalAlignment="Center" Margin="0,0,0,18">
                        <TextBlock FontSize="18" FontWeight="Bold">
                            <Run Text="👀 Memorize as cartas! Viram em " />
                            <Run Text="{Binding TempoPreview}" />
                            <Run Text="s..." />
                        </TextBlock>
                    </Border>

                    <StackPanel IsVisible="{Binding !MostrandoPreview}" Orientation="Horizontal" HorizontalAlignment="Center"
                                Spacing="12" Margin="0,0,0,18">
                        <Border Background="{DynamicResource AppSurfaceAltBrush}" CornerRadius="999" Padding="14,8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="🟢" FontSize="13" />
                                <TextBlock FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}">
                                    <Run Text="{Binding ParesEncontrados}" />
                                    <Run Text=" / " />
                                    <Run Text="{Binding TotalParesConst}" />
                                    <Run Text=" pares" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource AppSurfaceAltBrush}" CornerRadius="999" Padding="14,8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="❌" FontSize="13" />
                                <TextBlock Text="{Binding Erros}" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Classes="card" Width="600">
                        <ItemsControl ItemsSource="{Binding Cartas}" HorizontalAlignment="Center"
                                      IsEnabled="{Binding !MostrandoPreview}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:CartaMemoria">
                                    <Button Classes="memory-card"
                                            Classes.revelada="{Binding Revelada}"
                                            Classes.combinada="{Binding Combinada}"
                                            IsEnabled="{Binding !Combinada}"
                                            AutomationProperties.Name="{Binding NomeAcessivel}"
                                            Command="{Binding #Root.((vm:MemoriaViewModel)DataContext).VirarCartaCommand}"
                                            CommandParameter="{Binding}">
                                        <Panel>
                                            <TextBlock Text="🦉" FontSize="30" IsVisible="{Binding !Revelada}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Texto}" IsVisible="{Binding Revelada}"
                                                       TextWrapping="Wrap" TextAlignment="Center"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Panel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>

                <!-- ===================== Resultado ===================== -->
                <StackPanel IsVisible="{Binding JogoConcluido}" Spacing="0" HorizontalAlignment="Center">
                    <Border Width="120" Height="120" CornerRadius="60" HorizontalAlignment="Center" Margin="0,0,0,20"
                            Background="{DynamicResource AppGreenBrush}" BoxShadow="0 14 30 0 #402FC48D">
                        <TextBlock Text="🏆" FontSize="56" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Fase concluída!" Classes="h1" HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock Text="{Binding Estrelinhas}" FontSize="34" HorizontalAlignment="Center" Margin="0,10,0,10"
                               Foreground="{DynamicResource AppYellowBrush}" />
                    <TextBlock Text="{Binding Erros, StringFormat='Você encontrou todos os pares com {0} tentativas erradas. Muita atenção! 🧠'}"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                               Classes="muted" Margin="0,0,0,26" />
                    <Button Content="Voltar à trilha 🗺️" Classes="primary" Command="{Binding VoltarTrilhaCommand}"
                            HorizontalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Panel>
</UserControl>
