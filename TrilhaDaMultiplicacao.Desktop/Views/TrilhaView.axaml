<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TrilhaDaMultiplicacao.Desktop.ViewModels"
             xmlns:models="using:TrilhaDaMultiplicacao.Desktop.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="760"
             x:Class="TrilhaDaMultiplicacao.Desktop.Views.TrilhaView"
             x:Name="Root"
             x:DataType="vm:TrilhaViewModel">

    <Panel ClipToBounds="True">

        <Border Background="{DynamicResource AppSceneGradientBrush}" />

        <Canvas IsHitTestVisible="False">
            <Border Canvas.Left="-60" Canvas.Top="-60" Width="220" Height="220" CornerRadius="110"
                    Background="{DynamicResource AppYellowBrush}" Opacity="0.20" />
            <Border Canvas.Left="1030" Canvas.Top="140" Width="200" Height="200" CornerRadius="100"
                    Background="{DynamicResource AppBlueBrush}" Opacity="0.16" />
            <TextBlock Text="⭐" FontSize="24" Canvas.Left="1040" Canvas.Top="380" Opacity="0.5" />
            <TextBlock Text="✨" FontSize="22" Canvas.Left="60" Canvas.Top="440" Opacity="0.5" />
        </Canvas>

        <Grid RowDefinitions="Auto,*">

            <!-- ===================== Boas-vindas + progresso ===================== -->
            <Border Grid.Row="0" Classes="card" Margin="24,20,24,14" Padding="18,14">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding AlunoNome, StringFormat='Olá, {0}! 👋'}" Classes="h2" />

                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Grid.Column="0" Text="🗺️" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                            <TextBlock Classes="muted" FontWeight="SemiBold">
                                <Run Text="Seu progresso: " />
                                <Run Text="{Binding FasesConcluidas}" FontWeight="Bold" />
                                <Run Text=" de " />
                                <Run Text="{Binding TotalFases}" FontWeight="Bold" />
                                <Run Text=" fases concluídas" />
                            </TextBlock>
                            <ProgressBar Value="{Binding ProgressoPercentual}" Minimum="0" Maximum="100"
                                         Height="10" CornerRadius="5"
                                         Foreground="{DynamicResource AppPrimaryGradientBrush}"
                                         Background="{DynamicResource AppSurfaceAltBrush}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===================== Trilha de fases ===================== -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel HorizontalAlignment="Center" Margin="0,6,0,50" Spacing="0">

                    <TextBlock Text="🏁 Comece aqui!" FontWeight="Bold" FontSize="13"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,4" />

                    <ItemsControl ItemsSource="{Binding Fases}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:FaseNode">
                                <Grid RowDefinitions="Auto,Auto" Width="{x:Static models:FaseNode.LinhaLargura}">

                                    <!-- Conector + nó -->
                                    <Canvas Grid.Row="0" Height="{x:Static models:FaseNode.LinhaAltura}" ClipToBounds="False">
                                        <Line IsVisible="{Binding TemConector}"
                                              StartPoint="{Binding PontoConectorInicio}" EndPoint="{Binding PontoConectorFim}"
                                              Stroke="{Binding CorConector}" StrokeThickness="7"
                                              StrokeDashArray="1,16" StrokeLineCap="Round" />

                                        <Panel Canvas.Left="{Binding X}" Canvas.Top="{Binding TopoNode}"
                                               Width="{Binding Tamanho}" Height="{Binding Tamanho}">
                                            <Border IsVisible="{Binding EhDisponivel}" CornerRadius="999"
                                                    Background="{DynamicResource AppYellowBrush}" Opacity="0.30"
                                                    Margin="-10" />

                                            <Button Classes="fase-node"
                                                    Classes.disponivel="{Binding EhDisponivel}"
                                                    Classes.bloqueada="{Binding EhBloqueada}"
                                                    Width="{Binding Tamanho}" Height="{Binding Tamanho}"
                                                    Background="{Binding Cor}"
                                                    ToolTip.Tip="{Binding Titulo}"
                                                    Command="{Binding #Root.((vm:TrilhaViewModel)DataContext).AbrirFaseCommand}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="{Binding Glyph}" FontSize="32"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Button>

                                            <Border IsVisible="{Binding EhConcluida}" Width="30" Height="30" CornerRadius="15"
                                                    Background="{DynamicResource AppGreenBrush}"
                                                    BorderBrush="White" BorderThickness="3"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Margin="0,-6,-6,0">
                                                <TextBlock Text="✓" FontSize="14" FontWeight="Bold" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <Border Background="{DynamicResource AppSurfaceBrush}" CornerRadius="999"
                                                    Padding="9,3" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                    Margin="0,0,0,-12" BoxShadow="0 2 6 0 #26243A66">
                                                <TextBlock Text="{Binding Numero}" FontSize="11" FontWeight="Bold"
                                                           Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                            </Border>
                                        </Panel>
                                    </Canvas>

                                    <!-- Rótulo -->
                                    <StackPanel Grid.Row="1" Width="156" HorizontalAlignment="Left"
                                                Margin="{Binding MargemRotulo}" Spacing="4">
                                        <TextBlock Text="{Binding Titulo}" Classes="muted" FontWeight="SemiBold"
                                                   TextAlignment="Center" TextWrapping="Wrap" FontSize="12.5"
                                                   Foreground="{DynamicResource AppTextPrimaryBrush}" />

                                        <TextBlock Text="{Binding Estrelinhas}" IsVisible="{Binding EhConcluida}"
                                                   Foreground="{DynamicResource AppYellowBrush}" FontSize="15"
                                                   HorizontalAlignment="Center" />

                                        <Button IsVisible="{Binding EhDisponivel}" Classes="jogar-pill" HorizontalAlignment="Center"
                                                Command="{Binding #Root.((vm:TrilhaViewModel)DataContext).AbrirFaseCommand}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="JOGAR" FontSize="11" FontWeight="Bold" Foreground="White" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="🏆" FontSize="42" HorizontalAlignment="Center" Margin="0,20,0,0" Opacity="0.85" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ===================== Banner de aviso ===================== -->
        <Border IsVisible="{Binding HasInfo}" Classes="toast-banner"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28">
            <TextBlock Text="{Binding InfoMessage}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="440" TextAlignment="Center" />
        </Border>
    </Panel>
</UserControl>
