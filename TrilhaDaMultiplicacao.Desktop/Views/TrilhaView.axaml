<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TrilhaDaMultiplicacao.Desktop.ViewModels"
             xmlns:models="using:TrilhaDaMultiplicacao.Desktop.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="760"
             x:Class="TrilhaDaMultiplicacao.Desktop.Views.TrilhaView"
             x:Name="Root"
             x:DataType="vm:TrilhaViewModel">

    <Panel ClipToBounds="True">

        <Border Background="{DynamicResource AppSceneGradientBrush}" />

        <Canvas IsHitTestVisible="False">
            <Border Canvas.Left="-60" Canvas.Top="-60" Width="220" Height="220" CornerRadius="110"
                    Background="{DynamicResource AppYellowBrush}" Opacity="0.20" />
            <Border Canvas.Left="1030" Canvas.Top="140" Width="200" Height="200" CornerRadius="100"
                    Background="{DynamicResource AppBlueBrush}" Opacity="0.16" />
            <TextBlock Text="⭐" FontSize="24" Canvas.Left="1040" Canvas.Top="380" Opacity="0.5" />
            <TextBlock Text="✨" FontSize="22" Canvas.Left="60" Canvas.Top="440" Opacity="0.5" />
        </Canvas>

        <Grid RowDefinitions="Auto,*">

            <!-- ===================== Cabeçalho ===================== -->
            <Border Grid.Row="0" Classes="card" Margin="24,20,24,10" Padding="18,14">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <Border Grid.Column="0" Width="54" Height="54" CornerRadius="27"
                            Background="{DynamicResource AppMascotGradientBrush}">
                        <TextBlock Text="🦉" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0" Spacing="1">
                        <TextBlock Text="{Binding AlunoNome, StringFormat='Olá, {0}! 👋'}" Classes="h2" />
                        <TextBlock Text="Continue sua jornada pela trilha da multiplicação!" Classes="muted" />
                    </StackPanel>

                    <Border Grid.Column="2" Background="{DynamicResource AppSurfaceAltBrush}" CornerRadius="999"
                            Padding="14,8" Margin="0,0,10,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="⭐" FontSize="15" />
                            <TextBlock Text="{Binding TotalEstrelas}" FontWeight="Bold"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Button Grid.Column="3" Content="Sair" Classes="link" Command="{Binding SairCommand}"
                            VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- ===================== Trilha de fases ===================== -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Canvas Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}"
                        HorizontalAlignment="Center" Margin="0,6,0,40">

                    <Polyline Points="{Binding TrilhaPontos}"
                              Stroke="{DynamicResource AppBorderBrush}"
                              StrokeThickness="8"
                              StrokeDashArray="0.1,20"
                              StrokeJoin="Round"
                              StrokeLineCap="Round" />

                    <TextBlock Text="🏁 Comece aqui!" FontWeight="Bold" FontSize="13"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               Canvas.Left="{Binding PrimeiraFaseX}" Canvas.Top="8" />

                    <TextBlock Text="🏆" FontSize="40"
                               Canvas.Left="{Binding UltimaFaseX}" Canvas.Top="{Binding UltimaFaseY}"
                               Opacity="0.8" />

                    <ItemsControl ItemsSource="{Binding Fases}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemContainerTheme>
                            <ControlTheme TargetType="ContentPresenter" x:DataType="models:FaseNode">
                                <Setter Property="Canvas.Left" Value="{Binding X}" />
                                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                            </ControlTheme>
                        </ItemsControl.ItemContainerTheme>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:FaseNode">
                                <Panel Width="150">
                                    <StackPanel HorizontalAlignment="Center" Spacing="6" Width="150">

                                        <Panel Width="{Binding Tamanho}" Height="{Binding Tamanho}" HorizontalAlignment="Center">
                                            <Button Classes="fase-node"
                                                    Classes.disponivel="{Binding EhDisponivel}"
                                                    Classes.bloqueada="{Binding EhBloqueada}"
                                                    Width="{Binding Tamanho}" Height="{Binding Tamanho}"
                                                    Background="{Binding Cor}"
                                                    ToolTip.Tip="{Binding Titulo}"
                                                    Command="{Binding #Root.((vm:TrilhaViewModel)DataContext).AbrirFaseCommand}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="{Binding Glyph}" FontSize="30"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Button>

                                            <Border IsVisible="{Binding EhConcluida}" Width="28" Height="28" CornerRadius="14"
                                                    Background="{DynamicResource AppGreenBrush}"
                                                    BorderBrush="White" BorderThickness="3"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Margin="0,-4,-4,0">
                                                <TextBlock Text="✓" FontSize="13" FontWeight="Bold" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Panel>

                                        <TextBlock Text="{Binding Titulo}" Classes="muted" FontWeight="SemiBold"
                                                   TextAlignment="Center" TextWrapping="Wrap" Width="146" FontSize="12.5"
                                                   Foreground="{DynamicResource AppTextPrimaryBrush}" />

                                        <TextBlock Text="{Binding Estrelinhas}" IsVisible="{Binding EhConcluida}"
                                                   Foreground="{DynamicResource AppYellowBrush}" FontSize="15"
                                                   HorizontalAlignment="Center" />

                                        <Border IsVisible="{Binding EhDisponivel}" Classes="jogar-pill" HorizontalAlignment="Center">
                                            <TextBlock Text="JOGAR" FontSize="11" FontWeight="Bold" Foreground="White" />
                                        </Border>
                                    </StackPanel>
                                </Panel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Canvas>
            </ScrollViewer>
        </Grid>

        <!-- ===================== Banner de aviso ===================== -->
        <Border IsVisible="{Binding HasInfo}" Classes="toast-banner"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28">
            <TextBlock Text="{Binding InfoMessage}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="440" TextAlignment="Center" />
        </Border>
    </Panel>
</UserControl>
