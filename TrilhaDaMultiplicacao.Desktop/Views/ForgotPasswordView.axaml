<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TrilhaDaMultiplicacao.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="760"
             x:Class="TrilhaDaMultiplicacao.Desktop.Views.ForgotPasswordView"
             x:DataType="vm:ForgotPasswordViewModel">

    <Panel ClipToBounds="True">

        <Border Background="{DynamicResource AppSceneGradientBrush}" />

        <Canvas IsHitTestVisible="False">
            <Border Canvas.Left="-50" Canvas.Top="-50" Width="210" Height="210" CornerRadius="105"
                    Background="{DynamicResource AppRedBrush}" Opacity="0.16" />
            <Border Canvas.Left="1010" Canvas.Top="-60" Width="230" Height="230" CornerRadius="115"
                    Background="{DynamicResource AppBlueBrush}" Opacity="0.18" />
            <Border Canvas.Left="1040" Canvas.Top="580" Width="190" Height="190" CornerRadius="95"
                    Background="{DynamicResource AppYellowBrush}" Opacity="0.22" />
            <TextBlock Text="🔑" FontSize="46" Canvas.Left="150" Canvas.Top="560" Opacity="0.45">
                <TextBlock.RenderTransform>
                    <RotateTransform Angle="-12" />
                </TextBlock.RenderTransform>
            </TextBlock>
            <TextBlock Text="✨" FontSize="24" Canvas.Left="920" Canvas.Top="200" Opacity="0.55" />
        </Canvas>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40,28" Spacing="0">

                <Border Width="92" Height="92" CornerRadius="46" HorizontalAlignment="Center" Margin="0,0,0,14"
                        Background="{DynamicResource AppMascotGradientBrush}" BoxShadow="0 10 24 0 #40F5590C">
                    <TextBlock Text="🔐" FontSize="42" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <TextBlock Text="Recuperar senha" Classes="h1" HorizontalAlignment="Center" TextAlignment="Center" />
                <TextBlock Text="Sem crise! Vamos te ajudar a voltar a jogar. 🌟" Classes="muted"
                           HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,20" />

                <!-- Indicador de etapas -->
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,0,0,22"
                            IsVisible="{Binding !NoConcluido}">
                    <Border Classes="step-dot" Classes.ativo="{Binding NoEmail}" Classes.feito="{Binding Passo1Feito}" />
                    <Border Classes="step-dot" Classes.ativo="{Binding NaPergunta}" Classes.feito="{Binding Passo2Feito}" />
                    <Border Classes="step-dot" Classes.ativo="{Binding NaNovaSenha}" Classes.feito="{Binding Passo3Feito}" />
                </StackPanel>

                <Border Classes="card" Width="420">
                    <StackPanel Spacing="0">

                        <!-- Passo 1: e-mail -->
                        <StackPanel IsVisible="{Binding NoEmail}" Spacing="0">
                            <TextBlock Text="📧  QUAL É O SEU E-MAIL?" Classes="field-label" />
                            <TextBox Text="{Binding Email}" PlaceholderText="seuemail@exemplo.com" Margin="0,0,0,6">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding AvancarEmailCommand}" />
                                </TextBox.KeyBindings>
                            </TextBox>
                        </StackPanel>

                        <!-- Passo 2: pergunta de segurança -->
                        <StackPanel IsVisible="{Binding NaPergunta}" Spacing="0">
                            <TextBlock Text="🛟  PERGUNTA DE SEGURANÇA" Classes="field-label" />
                            <Border Background="{DynamicResource AppSurfaceAltBrush}" CornerRadius="14" Padding="16,13" Margin="0,0,0,16">
                                <TextBlock Text="{Binding PerguntaExibida}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource AppTextPrimaryBrush}" FontWeight="SemiBold" />
                            </Border>
                            <TextBlock Text="✏️  SUA RESPOSTA" Classes="field-label" />
                            <TextBox Text="{Binding RespostaSeguranca}" PlaceholderText="Digite sua resposta" Margin="0,0,0,6">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding AvancarPerguntaCommand}" />
                                </TextBox.KeyBindings>
                            </TextBox>
                        </StackPanel>

                        <!-- Passo 3: nova senha -->
                        <StackPanel IsVisible="{Binding NaNovaSenha}" Spacing="0">
                            <TextBlock Text="🔒  NOVA SENHA" Classes="field-label" />
                            <TextBox Text="{Binding NovaSenha}" PasswordChar="●" PlaceholderText="Crie uma nova senha" Margin="0,0,0,16" />

                            <TextBlock Text="🔒  CONFIRMAR NOVA SENHA" Classes="field-label" />
                            <TextBox Text="{Binding ConfirmarNovaSenha}" PasswordChar="●" PlaceholderText="Repita a nova senha" Margin="0,0,0,6">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding ConcluirCommand}" />
                                </TextBox.KeyBindings>
                            </TextBox>
                        </StackPanel>

                        <!-- Sucesso -->
                        <StackPanel IsVisible="{Binding NoConcluido}" Spacing="0" HorizontalAlignment="Center">
                            <Border Width="84" Height="84" CornerRadius="42" HorizontalAlignment="Center" Margin="0,4,0,16"
                                    Background="{DynamicResource AppGreenBrush}" BoxShadow="0 12 26 0 #402FC48D">
                                <TextBlock Text="✅" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Senha alterada com sucesso!" Classes="h2" HorizontalAlignment="Center" TextAlignment="Center" />
                            <TextBlock Text="Agora é só entrar com sua nova senha." Classes="muted"
                                       HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,20" />
                        </StackPanel>

                        <TextBlock Text="{Binding ErrorMessage}" Classes="error-text" IsVisible="{Binding HasError}" Margin="0,4,0,6" />

                        <!-- Ações -->
                        <Button Content="Avançar →" Classes="primary" Command="{Binding AvancarEmailCommand}"
                                IsVisible="{Binding NoEmail}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,10,0,0" />

                        <Grid ColumnDefinitions="Auto,*" Margin="0,10,0,0" IsVisible="{Binding NaPergunta}">
                            <Button Grid.Column="0" Content="← Voltar" Classes="secondary" Command="{Binding VoltarCommand}" />
                            <Button Grid.Column="1" Content="Avançar →" Classes="primary" Command="{Binding AvancarPerguntaCommand}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="10,0,0,0" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" Margin="0,10,0,0" IsVisible="{Binding NaNovaSenha}">
                            <Button Grid.Column="0" Content="← Voltar" Classes="secondary" Command="{Binding VoltarCommand}" />
                            <Button Grid.Column="1" Content="Concluir ✅" Classes="primary" Command="{Binding ConcluirCommand}"
                                    IsEnabled="{Binding !IsBusy}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="10,0,0,0" />
                        </Grid>

                        <ProgressBar IsIndeterminate="True" Height="4" CornerRadius="2" Margin="0,10,0,0"
                                     Foreground="{DynamicResource AppOrangeBrush}" Background="Transparent"
                                     IsVisible="{Binding IsBusy}" />

                        <Button Content="Ir para o login 🚪" Classes="primary" Command="{Binding IrParaLoginCommand}"
                                IsVisible="{Binding NoConcluido}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Button Content="← Voltar ao login" Classes="link" Command="{Binding VoltarCommand}"
                        IsVisible="{Binding NoEmail}" HorizontalAlignment="Center" Margin="0,20,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Panel>
</UserControl>
