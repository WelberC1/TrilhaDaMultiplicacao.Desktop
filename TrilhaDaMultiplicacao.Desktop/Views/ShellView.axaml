<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TrilhaDaMultiplicacao.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="760"
             x:Class="TrilhaDaMultiplicacao.Desktop.Views.ShellView"
             x:DataType="vm:ShellViewModel"
             Background="{DynamicResource AppBackgroundBrush}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ===================== Barra superior ===================== -->
        <Border Grid.Row="0" Background="{DynamicResource AppSurfaceBrush}" Padding="20,12"
                BoxShadow="0 2 10 0 #1A243A66">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21"
                        Background="{DynamicResource AppMascotGradientBrush}">
                    <TextBlock Text="{Binding AvatarEmoji}" FontSize="20"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <TextBlock Grid.Column="1" Text="{Binding AlunoNome}" Classes="h2" VerticalAlignment="Center"
                           Margin="12,0,0,0" />

                <Border Grid.Column="2" Background="{DynamicResource AppSurfaceAltBrush}" CornerRadius="999"
                        Padding="14,7" Margin="0,0,12,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="🏅" FontSize="14" />
                        <TextBlock Text="{Binding PontosTotais}" FontWeight="Bold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Button Grid.Column="3" Content="Sair" Classes="link" Command="{Binding SairCommand}"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ===================== Conteúdo da aba ===================== -->
        <ContentControl Grid.Row="1" Content="{Binding AbaConteudo}" />

        <!-- ===================== Barra de abas ===================== -->
        <Border Grid.Row="2" Background="{DynamicResource AppSurfaceBrush}" Padding="10,8"
                BoxShadow="0 -2 10 0 #1A243A66">
            <Grid ColumnDefinitions="*,*,*,*">
                <Button Grid.Column="0" Classes="tab-button" Classes.ativo="{Binding NaTrilha}"
                        AutomationProperties.Name="Trilha"
                        Command="{Binding IrParaTrilhaCommand}" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="2">
                        <TextBlock Text="🗺️" FontSize="20" HorizontalAlignment="Center" />
                        <TextBlock Text="Trilha" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Classes="tab-button" Classes.ativo="{Binding NoRanking}"
                        AutomationProperties.Name="Ranking"
                        Command="{Binding IrParaRankingCommand}" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="2">
                        <TextBlock Text="🏆" FontSize="20" HorizontalAlignment="Center" />
                        <TextBlock Text="Ranking" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Classes="tab-button" Classes.ativo="{Binding NasConquistas}"
                        AutomationProperties.Name="Conquistas"
                        Command="{Binding IrParaConquistasCommand}" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="2">
                        <TextBlock Text="🎖️" FontSize="20" HorizontalAlignment="Center" />
                        <TextBlock Text="Conquistas" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="3" Classes="tab-button" Classes.ativo="{Binding NaConta}"
                        AutomationProperties.Name="Conta"
                        Command="{Binding IrParaContaCommand}" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="2">
                        <TextBlock Text="👤" FontSize="20" HorizontalAlignment="Center" />
                        <TextBlock Text="Conta" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
