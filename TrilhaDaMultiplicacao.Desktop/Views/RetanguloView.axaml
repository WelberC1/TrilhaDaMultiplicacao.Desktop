<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TrilhaDaMultiplicacao.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="760"
             x:Class="TrilhaDaMultiplicacao.Desktop.Views.RetanguloView"
             x:Name="Root"
             x:DataType="vm:RetanguloViewModel">

    <Panel ClipToBounds="True">

        <Border Background="{DynamicResource AppSceneGradientBrush}" />

        <Canvas IsHitTestVisible="False">
            <Border Canvas.Left="-50" Canvas.Top="-50" Width="210" Height="210" CornerRadius="105"
                    Background="{DynamicResource AppVioletGradientBrush}" Opacity="0.16" />
            <Border Canvas.Left="1010" Canvas.Top="-60" Width="230" Height="230" CornerRadius="115"
                    Background="{DynamicResource AppBlueBrush}" Opacity="0.14" />
            <Border Canvas.Left="1030" Canvas.Top="580" Width="190" Height="190" CornerRadius="95"
                    Background="{DynamicResource AppYellowBrush}" Opacity="0.18" />
            <TextBlock Text="🧱" FontSize="46" Canvas.Left="140" Canvas.Top="560" Opacity="0.4">
                <TextBlock.RenderTransform>
                    <RotateTransform Angle="-10" />
                </TextBlock.RenderTransform>
            </TextBlock>
            <TextBlock Text="✨" FontSize="24" Canvas.Left="940" Canvas.Top="220" Opacity="0.55" />
        </Canvas>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40,24" Spacing="0">

                <!-- ===================== Jogo ===================== -->
                <StackPanel IsVisible="{Binding !JogoConcluido}" Spacing="0" HorizontalAlignment="Center">
                    <Border Width="86" Height="86" CornerRadius="43" HorizontalAlignment="Center" Margin="0,0,0,10"
                            Background="{DynamicResource AppVioletGradientBrush}" BoxShadow="0 10 24 0 #406C3CE0">
                        <TextBlock Text="🧱" FontSize="38" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Text="{Binding TituloFase}" Classes="h1" HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock Text="{Binding NumeroExibido, StringFormat='Desafio {0} de 5'}" Classes="muted"
                               HorizontalAlignment="Center" Margin="0,4,0,14" />

                    <ProgressBar Value="{Binding NumeroExibido}" Maximum="5" Width="420" Height="8" CornerRadius="4" Margin="0,0,0,18"
                                 Foreground="{DynamicResource AppVioletGradientBrush}" Background="{DynamicResource AppBorderBrush}" />

                    <Border Classes="card" Width="560">
                        <StackPanel Spacing="0" HorizontalAlignment="Center">

                            <TextBlock Text="{Binding TextoDesafio}" FontSize="26" FontWeight="ExtraBold"
                                       HorizontalAlignment="Center" TextAlignment="Center"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}" />
                            <TextBlock Text="Ajuste as linhas e as colunas até formar o retângulo certo!" Classes="muted"
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                       MaxWidth="360" Margin="0,4,0,16" />

                            <Border Classes="total-pill" Classes.resolvido="{Binding Resolvido}"
                                    HorizontalAlignment="Center" Margin="0,0,0,20">
                                <TextBlock FontSize="20" FontWeight="ExtraBold">
                                    <Run Text="{Binding LinhasAtuais}" />
                                    <Run Text=" × " />
                                    <Run Text="{Binding ColunasAtuais}" />
                                    <Run Text=" = " />
                                    <Run Text="{Binding TotalAtual}" />
                                </TextBlock>
                            </Border>

                            <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto" HorizontalAlignment="Center">

                                <!-- Controle de linhas -->
                                <StackPanel Grid.Column="0" Grid.Row="0" VerticalAlignment="Center"
                                            Spacing="8" Margin="0,0,14,0">
                                    <Button Content="▲" Classes="stepper" Command="{Binding AumentarLinhasCommand}"
                                            IsEnabled="{Binding PodeAumentarLinhas}" />
                                    <Border Classes="stepper-value">
                                        <TextBlock Text="{Binding LinhasAtuais}" />
                                    </Border>
                                    <Button Content="▼" Classes="stepper" Command="{Binding DiminuirLinhasCommand}"
                                            IsEnabled="{Binding PodeDiminuirLinhas}" />
                                </StackPanel>

                                <!-- Grade de quadradinhos -->
                                <Border Grid.Column="1" Grid.Row="0" Classes="grid-frame" MinWidth="280" MinHeight="150">
                                    <ItemsControl ItemsSource="{Binding Celulas}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="{Binding ColunasAtuais}" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:Int32">
                                                <Border Classes="cell-block"
                                                        Classes.resolvido="{Binding #Root.((vm:RetanguloViewModel)DataContext).Resolvido}">
                                                    <TextBlock Text="{Binding #Root.((vm:RetanguloViewModel)DataContext).IconeAtual}"
                                                               FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>

                                <Border Grid.Column="0" Grid.Row="1" />

                                <!-- Controle de colunas -->
                                <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center"
                                            Spacing="8" Margin="0,14,0,0">
                                    <Button Content="◀" Classes="stepper" Command="{Binding DiminuirColunasCommand}"
                                            IsEnabled="{Binding PodeDiminuirColunas}" />
                                    <Border Classes="stepper-value">
                                        <TextBlock Text="{Binding ColunasAtuais}" />
                                    </Border>
                                    <Button Content="▶" Classes="stepper" Command="{Binding AumentarColunasCommand}"
                                            IsEnabled="{Binding PodeAumentarColunas}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{Binding TextoSucesso}" Classes="info-text" TextWrapping="Wrap" TextAlignment="Center"
                                       FontSize="15.5" Margin="4,20,4,0" IsVisible="{Binding Resolvido}" />

                            <Button Content="{Binding TextoBotaoContinuar}"
                                    IsVisible="{Binding Resolvido}" Classes="primary" Command="{Binding ContinuarCommand}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,14,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===================== Resultado ===================== -->
                <StackPanel IsVisible="{Binding JogoConcluido}" Spacing="0" HorizontalAlignment="Center">
                    <Border Width="120" Height="120" CornerRadius="60" HorizontalAlignment="Center" Margin="0,0,0,20"
                            Background="{DynamicResource AppGreenBrush}" BoxShadow="0 14 30 0 #402FC48D">
                        <TextBlock Text="🏆" FontSize="56" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Fase concluída!" Classes="h1" HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock Text="{Binding Estrelinhas}" FontSize="34" HorizontalAlignment="Center" Margin="0,10,0,10"
                               Foreground="{DynamicResource AppYellowBrush}" />
                    <TextBlock Text="{Binding Acertos, StringFormat='Você montou {0} de 5 retângulos direto de primeira. Mandou bem! 🧱'}"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                               Classes="muted" Margin="0,0,0,26" />
                    <Button Content="Voltar à trilha 🗺️" Classes="primary" Command="{Binding VoltarTrilhaCommand}"
                            HorizontalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Panel>
</UserControl>
