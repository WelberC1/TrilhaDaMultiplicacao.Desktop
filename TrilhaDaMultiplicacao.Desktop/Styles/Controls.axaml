<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ===================== Tipografia ===================== -->
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="30" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="19" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="TextBlock.field-label">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
    <Setter Property="Margin" Value="4,0,0,6" />
  </Style>
  <Style Selector="TextBlock.error-text">
    <Setter Property="Foreground" Value="{DynamicResource AppRedBrush}" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.info-text">
    <Setter Property="Foreground" Value="{DynamicResource AppBlueBrush}" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- ===================== Botões ===================== -->
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button:pressed">
    <Setter Property="RenderTransform" Value="scale(0.97)" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource AppPrimaryGradientBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Padding" Value="20,15" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Opacity" Value="0.94" />
  </Style>
  <Style Selector="Button.primary:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.03)" />
  </Style>
  <Style Selector="Button.primary:disabled">
    <Setter Property="Opacity" Value="0.6" />
  </Style>

  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AppBlueBrush}" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="13.5" />
  </Style>
  <Style Selector="Button.link:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource AppOrangeBrush}" />
  </Style>

  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="{DynamicResource AppSurfaceAltBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
    <Setter Property="Padding" Value="18,13" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Button.secondary:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppBorderBrush}" />
  </Style>

  <!-- ===================== Opções de resposta (jogos) ===================== -->
  <Style Selector="Button.option">
    <Setter Property="Background" Value="{DynamicResource AppSurfaceAltBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
    <Setter Property="Padding" Value="18,14" />
    <Setter Property="FontSize" Value="15.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Button.option:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppBorderBrush}" />
  </Style>
  <Style Selector="Button.option:disabled">
    <Setter Property="Opacity" Value="0.55" />
  </Style>

  <!-- ===================== Jogo: Monte o Retângulo ===================== -->
  <Style Selector="Button.stepper">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="46" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Background" Value="{DynamicResource AppSurfaceAltBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.stepper:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppBorderBrush}" />
  </Style>
  <Style Selector="Button.stepper:disabled">
    <Setter Property="Opacity" Value="0.35" />
  </Style>

  <Style Selector="Border.stepper-value">
    <Setter Property="MinWidth" Value="46" />
    <Setter Property="Height" Value="38" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="{DynamicResource AppVioletGradientBrush}" />
  </Style>
  <Style Selector="Border.stepper-value TextBlock">
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.grid-frame">
    <Setter Property="Background" Value="{DynamicResource AppSurfaceAltBrush}" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Padding" Value="10" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <Style Selector="Border.cell-block">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Margin" Value="3" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Background" Value="{DynamicResource AppVioletGradientBrush}" />
    <Setter Property="BoxShadow" Value="0 2 4 0 #302A1B5E" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.2" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.cell-block.resolvido">
    <Setter Property="Background" Value="{DynamicResource AppGreenBrush}" />
  </Style>

  <Style Selector="Border.total-pill">
    <Setter Property="Background" Value="{DynamicResource AppSurfaceAltBrush}" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="22,10" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.25" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.total-pill TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
  </Style>
  <Style Selector="Border.total-pill.resolvido">
    <Setter Property="Background" Value="{DynamicResource AppGreenBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppGreenBrush}" />
  </Style>
  <Style Selector="Border.total-pill.resolvido TextBlock">
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- ===================== Jogo: Memória Numérica ===================== -->
  <Style Selector="Button.memory-card">
    <Setter Property="Width" Value="122" />
    <Setter Property="Height" Value="92" />
    <Setter Property="Margin" Value="7" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="{DynamicResource AppBlueGradientBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="RenderTransform" Value="scale(1)" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.2" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="BackEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.memory-card:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.05)" />
  </Style>
  <Style Selector="Button.memory-card:disabled">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Button.memory-card.revelada">
    <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBlueBrush}" />
    <Setter Property="BorderThickness" Value="3" />
  </Style>
  <Style Selector="Button.memory-card.revelada">
    <Setter Property="RenderTransform" Value="scale(1)" />
    <Style.Animations>
      <Animation Duration="0:0:0.3" IterationCount="1" Easing="BackEaseOut">
        <KeyFrame Cue="0%">
          <Setter Property="(ScaleTransform.ScaleX)" Value="0.6" />
          <Setter Property="(ScaleTransform.ScaleY)" Value="0.6" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="(ScaleTransform.ScaleX)" Value="1.0" />
          <Setter Property="(ScaleTransform.ScaleY)" Value="1.0" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Button.memory-card.combinada">
    <Setter Property="Background" Value="{DynamicResource AppGreenBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>

  <!-- ===================== Jogo: Certo ou Errado? ===================== -->
  <Style Selector="Button.answer-true">
    <Setter Property="Background" Value="{DynamicResource AppGreenBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Padding" Value="20,22" />
    <Setter Property="FontSize" Value="19" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.answer-true:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.03)" />
  </Style>
  <Style Selector="Button.answer-true:disabled">
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <Style Selector="Button.answer-false">
    <Setter Property="Background" Value="{DynamicResource AppRedGradientBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Padding" Value="20,22" />
    <Setter Property="FontSize" Value="19" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.answer-false:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.03)" />
  </Style>
  <Style Selector="Button.answer-false:disabled">
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <!-- ===================== Nós da trilha ===================== -->
  <Style Selector="Button.fase-node">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="4" />
    <Setter Property="BorderBrush" Value="White" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.fase-node:pointerover">
    <Setter Property="Opacity" Value="0.85" />
  </Style>
  <Style Selector="Button.fase-node.bloqueada">
    <Setter Property="Opacity" Value="0.6" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.fase-node.disponivel">
    <Setter Property="BorderBrush" Value="{DynamicResource AppYellowBrush}" />
    <Setter Property="RenderTransform">
      <ScaleTransform ScaleX="1" ScaleY="1" />
    </Setter>
    <Style.Animations>
      <Animation Duration="0:0:1.1" IterationCount="INFINITE" Easing="SineEaseInOut">
        <KeyFrame Cue="0%">
          <Setter Property="(ScaleTransform.ScaleX)" Value="1.0" />
          <Setter Property="(ScaleTransform.ScaleY)" Value="1.0" />
        </KeyFrame>
        <KeyFrame Cue="50%">
          <Setter Property="(ScaleTransform.ScaleX)" Value="1.08" />
          <Setter Property="(ScaleTransform.ScaleY)" Value="1.08" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="(ScaleTransform.ScaleX)" Value="1.0" />
          <Setter Property="(ScaleTransform.ScaleY)" Value="1.0" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <Style Selector="Border.jogar-pill">
    <Setter Property="Background" Value="{DynamicResource AppPrimaryGradientBrush}" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="14,5" />
  </Style>

  <!-- ===================== Banner flutuante ===================== -->
  <Style Selector="Border.toast-banner">
    <Setter Property="Background" Value="{DynamicResource AppPrimaryGradientBrush}" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="20,14" />
    <Setter Property="BoxShadow" Value="0 12 30 0 #40000000" />
  </Style>

  <!-- ===================== Indicador de etapas ===================== -->
  <Style Selector="Border.step-dot">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="{DynamicResource AppBorderBrush}" />
  </Style>
  <Style Selector="Border.step-dot.ativo">
    <Setter Property="Width" Value="28" />
    <Setter Property="Background" Value="{DynamicResource AppPrimaryGradientBrush}" />
  </Style>
  <Style Selector="Border.step-dot.feito">
    <Setter Property="Background" Value="{DynamicResource AppGreenBrush}" />
  </Style>

  <!-- ===================== Cartões ===================== -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
    <Setter Property="CornerRadius" Value="28" />
    <Setter Property="Padding" Value="20" />
    <Setter Property="BoxShadow" Value="0 20 60 0 #26243A66" />
  </Style>

  <Style Selector="Border.blob">
    <Setter Property="Opacity" Value="0.55" />
  </Style>

  <!-- ===================== Campos de entrada ===================== -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource AppSurfaceAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="16,13" />
    <Setter Property="FontSize" Value="15.5" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource AppOrangeBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource AppYellowBrush}" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource AppOrangeBrush}" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource AppSurfaceAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="16,13" />
    <Setter Property="FontSize" Value="15.5" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <Style Selector="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
    <Setter Property="FontSize" Value="13.5" />
  </Style>

  <!-- ===================== Casca: barra de abas ===================== -->
  <Style Selector="Button.tab-button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.tab-button:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppSurfaceAltBrush}" />
  </Style>
  <Style Selector="Button.tab-button.ativo">
    <Setter Property="Foreground" Value="{DynamicResource AppOrangeBrush}" />
  </Style>
  <Style Selector="Button.tab-button.ativo TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AppOrangeBrush}" />
  </Style>

  <!-- ===================== Conta: seletor de avatar ===================== -->
  <Style Selector="Button.avatar-option">
    <Setter Property="Width" Value="58" />
    <Setter Property="Height" Value="58" />
    <Setter Property="Margin" Value="5" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Background" Value="{DynamicResource AppSurfaceAltBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="3" />
    <Setter Property="FontSize" Value="24" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.avatar-option:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.08)" />
  </Style>
  <Style Selector="Button.avatar-option.selecionado">
    <Setter Property="BorderBrush" Value="{DynamicResource AppOrangeBrush}" />
    <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
  </Style>

  <!-- ===================== Conquistas ===================== -->
  <Style Selector="Border.achievement-card">
    <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="BoxShadow" Value="0 10 24 0 #26243A66" />
  </Style>
  <Style Selector="Border.achievement-card.bloqueada">
    <Setter Property="Opacity" Value="0.55" />
    <Setter Property="BoxShadow" Value="none" />
  </Style>
  <Style Selector="Border.achievement-icon">
    <Setter Property="Width" Value="60" />
    <Setter Property="Height" Value="60" />
    <Setter Property="CornerRadius" Value="30" />
    <Setter Property="Background" Value="{DynamicResource AppMascotGradientBrush}" />
  </Style>
  <Style Selector="Border.achievement-icon.bloqueada">
    <Setter Property="Background" Value="{DynamicResource AppSurfaceAltBrush}" />
  </Style>

  <!-- ===================== Ranking ===================== -->
  <Style Selector="Border.ranking-row">
    <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="Margin" Value="0,4" />
  </Style>
  <Style Selector="Border.ranking-row TextBlock.linha-texto">
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
  </Style>
  <Style Selector="Border.ranking-row.voce">
    <Setter Property="Background" Value="{DynamicResource AppPrimaryGradientBrush}" />
  </Style>
  <Style Selector="Border.ranking-row.voce TextBlock.linha-texto">
    <Setter Property="Foreground" Value="White" />
  </Style>

</Styles>
